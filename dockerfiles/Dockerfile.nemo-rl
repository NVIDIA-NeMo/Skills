# syntax=docker/dockerfile:1
# Pin this version so we can update it in one place later.
ARG BASE_IMAGE=nvcr.io/nvidian/nemo-rl:733c7d6-48669320

FROM ${BASE_IMAGE}

USER root

ENV NRL_CONTAINER=1
ENV PATH="/opt/nemo_rl_venv/bin:$PATH"

# Keep a compatibility symlink for paths that may still reference the older
# mixed-case location used by previous local images.
RUN if [ ! -e /opt/NeMo-RL ] && [ -e /opt/nemo-rl ]; then ln -s /opt/nemo-rl /opt/NeMo-RL; fi

WORKDIR /opt/NeMo-Skills

# Install the current repo on top of the pinned upstream NeMo-RL image so local
# NeMo-Skills changes are exercised in tests.
COPY . /opt/NeMo-Skills
RUN uv pip install /opt/NeMo-Skills
