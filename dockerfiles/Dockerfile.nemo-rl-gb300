# syntax=docker/dockerfile:1
# GB300 Megatron/SFT image pinned to NeMo-RL v0.7.0.
#
# This image intentionally installs only the MCore training backend. NeMo-RL's
# default actor isolation creates a separate uv environment on every Ray node
# when a prefetched environment cannot be reused. For a single-backend SFT
# image that isolation is unnecessary, so workers use the fully baked system
# environment instead. Runtime uv synchronization is disabled after the image
# has been built and validated.
#
# GB300 systems use Grace (ARM64) CPUs and Blackwell GPUs.
# Build:
#   docker buildx build --platform=linux/arm64 \
#     -f dockerfiles/Dockerfile.nemo-rl-gb300 \
#     --tag nemo-rl:v0.7.0-gb300 .
# Override the source with --build-arg NRL_GIT_REF=<git-ref> or:
#   --build-context nemo-rl=/path/to/NeMo-RL

FROM nvcr.io/nvidia/cuda-dl-base:26.03-cuda13.2-devel-ubuntu24.04 AS cuda-base

# Use an ordinary clone stage instead of Docker BuildKit's remote-Git ADD.
# This keeps the same pinned source and .git metadata while allowing native
# builds with Podman/Buildah on GB300 ARM64 compute nodes.
FROM cuda-base AS nemo-rl
ARG NRL_GIT_REF=v0.7.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --branch "${NRL_GIT_REF}" --depth 1 \
    --recurse-submodules --shallow-submodules \
    https://github.com/NVIDIA-NeMo/RL.git .

FROM cuda-base AS base

ENV NRL_CONTAINER=1
USER root

RUN export DEBIAN_FRONTEND=noninteractive \
    && export TZ=America/Los_Angeles \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        curl git gnupg jq less rsync vim wget \
    && . /etc/lsb-release \
    && echo "deb http://developer.download.nvidia.com/devtools/repos/ubuntu$(echo "$DISTRIB_RELEASE" | tr -d .)/$(dpkg --print-architecture) /" \
        > /etc/apt/sources.list.d/nvidia-devtools.list \
    && apt-key adv --fetch-keys \
        "http://developer.download.nvidia.com/compute/cuda/repos/ubuntu1804/$(uname -m | sed "s/aarch64/sbsa/")/7fa2af80.pub" \
    && apt-get update \
    && apt-get install -y --no-install-recommends nsight-systems-cli \
    && apt-get install -y --only-upgrade gnupg rsync \
    && (apt-get remove -y --purge ffmpeg || true) \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# CMake is required by CUDA extensions such as Transformer Engine and mamba-ssm.
ARG CMAKE_VERSION=3.31.1
RUN ARCH=$(uname -m) \
    && CMAKE_INSTALLER="cmake-${CMAKE_VERSION}-linux-${ARCH}" \
    && curl --retry 3 --retry-delay 2 -fsSL \
        -o "${CMAKE_INSTALLER}.tar.gz" \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${CMAKE_INSTALLER}.tar.gz" \
    && tar -xzf "${CMAKE_INSTALLER}.tar.gz" \
    && cp -r "${CMAKE_INSTALLER}/bin/"* /usr/local/bin/ \
    && cp -r "${CMAKE_INSTALLER}/share/"* /usr/local/share/ \
    && rm -rf "${CMAKE_INSTALLER}" "${CMAKE_INSTALLER}.tar.gz"

ARG UV_VERSION=0.11.18
ARG PYTHON_VERSION=3.13.13

# Keep both uv and its managed interpreter outside /root. HPC runtimes may
# replace or omit the root home mount, so tools required at runtime must live
# in the immutable image filesystem.
ENV UV_INSTALL_DIR=/usr/local/bin
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh \
    && /usr/local/bin/uv python install "${PYTHON_VERSION}"

ENV RAY_USAGE_STATS_ENABLED=0
ENV RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
ENV NEMO_RL_VENV_DIR=/opt/ray_venvs

FROM base AS hermetic

WORKDIR /opt/nemo-rl

ARG MAX_JOBS
ARG NVTE_BUILD_THREADS_PER_JOB

ENV UV_PROJECT_ENVIRONMENT=/opt/nemo_rl_venv
ENV UV_LINK_MODE=copy

# GB300 / Blackwell only. Grace-based GB300 nodes require linux/arm64.
ENV TORCH_CUDA_ARCH_LIST="10.0"
ENV NVTE_CUDA_ARCHS="100"
ENV CUDA_HOME=/usr/local/cuda
# CUDA 13 moved cuda/std headers under include/cccl.
ENV CPLUS_INCLUDE_PATH=/usr/local/cuda/include/cccl

# The CUDA ARM64 image stores its target payload under targets/sbsa-linux.
# Transformer Engine's CMake discovery can still construct the conventional
# x86_64-linux target path when this ARM64 image is built through binfmt on an
# x86 builder. Map that compatibility name to the real ARM64 payload; no x86
# libraries are introduced into the image.
RUN if [[ "$(uname -m)" == "aarch64" \
        && -d /usr/local/cuda/targets/sbsa-linux \
        && ! -e /usr/local/cuda/targets/x86_64-linux ]]; then \
        ln -s sbsa-linux /usr/local/cuda/targets/x86_64-linux; \
    fi

# Copy dependency metadata and MCore workspace sources before resolving. The
# project itself is installed after the complete NeMo-RL source is copied.
COPY --from=nemo-rl /src/pyproject.toml /src/uv.lock ./
COPY --from=nemo-rl /src/nemo_rl/__init__.py /src/nemo_rl/package_info.py ./nemo_rl/
COPY --from=nemo-rl /src/research/ ./research/
COPY --from=nemo-rl /src/3rdparty/ ./3rdparty/

# Use a BuildKit cache for build speed, but copy packages into the final venv.
# No installed file in /opt/nemo_rl_venv may depend on this ephemeral cache.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --seed \
    && uv sync --locked --extra mcore --no-install-project \
        --no-install-package transformer-engine

ENV PATH="/opt/nemo_rl_venv/bin:$PATH"

# Use the cuDNN packaged with the locked Python environment rather than a
# potentially different version supplied by the base image.
ENV CUDNN_HOME=/opt/nemo_rl_venv/lib/python3.13/site-packages/nvidia/cudnn
ENV LD_LIBRARY_PATH="/opt/nemo_rl_venv/lib/python3.13/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}"

FROM hermetic AS release

ARG NRL_GIT_REF=v0.7.0
ARG GB300_TRANSFORMER_ENGINE_VERSION=2.18.0
ARG GB300_CUDNN_VERSION=9.25.0.15
ARG GB300_CUDNN_FRONTEND_VERSION=1.26.0
ARG GB300_FLASH_ATTN_4_VERSION=4.0.0b8
ARG GB300_CUTLASS_DSL_VERSION=4.4.2
ARG NVIDIA_BUILD_ID
ARG NVIDIA_BUILD_REF
ARG RC_DATE=00.00
ARG TARGETARCH

# Export the requested versions so the validation step can verify the final
# environment.  Keeping these values in ENV also makes version changes visible
# to Podman/Buildah's layer cache.
ENV TRANSFORMER_ENGINE_VERSION=${GB300_TRANSFORMER_ENGINE_VERSION}
ENV CUDNN_VERSION=${GB300_CUDNN_VERSION}
ENV CUDNN_FRONTEND_VERSION=${GB300_CUDNN_FRONTEND_VERSION}
ENV FLASH_ATTN_4_VERSION=${GB300_FLASH_ATTN_4_VERSION}
ENV CUTLASS_DSL_VERSION=${GB300_CUTLASS_DSL_VERSION}

ENV NEMO_RL_COMMIT=${NRL_GIT_REF}
ENV NVIDIA_BUILD_ID=${NVIDIA_BUILD_ID:-<unknown>}
ENV NVIDIA_BUILD_REF=${NVIDIA_BUILD_REF:-<unknown>}

LABEL com.nvidia.build.id="${NVIDIA_BUILD_ID}"
LABEL com.nvidia.build.ref="${NVIDIA_BUILD_REF}"
LABEL com.nvidia.nemo-rl.accelerator="GB300"
LABEL com.nvidia.nemo-rl.backends="mcore,cudnn-fused-attention,flash-attention-2,flash-attention-4"

# These paths are used by NCCL on AWS EFA systems and are harmless elsewhere.
RUN printf '%s\n' /opt/amazon/ofi-nccl/lib /opt/amazon/efa/lib \
    > /etc/ld.so.conf.d/aws-efa.conf
ENV LD_LIBRARY_PATH="/opt/amazon/ofi-nccl/lib:/opt/amazon/efa/lib:${LD_LIBRARY_PATH}"

# Retain the dependency files already used to construct the environment.
COPY --from=nemo-rl /src/ /opt/nemo-rl/

RUN git rev-parse --is-shallow-repository | grep -q true \
    && git fetch --unshallow \
    || true

# Install the project and verify the complete GB300/MCore environment at build
# time. NEMO_RL_PY_EXECUTABLES_SYSTEM makes Ray actors use this baked Python
# directly; no per-node /opt/ray_venvs construction is needed for SFT.
ENV NEMO_RL_PY_EXECUTABLES_SYSTEM=1
# NeMo-RL v0.7.0 locks Transformer Engine 2.15 and cuDNN 9.20. That
# combination does not provide a backend for GB300/SM103 BF16 training with
# packed THD tensors, D=256, and context parallelism. Override the locked
# attention stack only after the final uv sync so a later sync cannot revert
# it. TE 2.18 adds Blackwell 10.x D=256 fused-attention backward support;
# packed THD with context parallelism requires cuDNN 9.25 or newer.
# The locked MCore environment carries Transformer Engine 2.13 components, so
# apply the GB300 TE 2.18 override last to prevent the lock from restoring them.
# The hermetic stage already contains every locked MCore dependency. A second
# full `uv sync` here would rebuild mamba, causal-conv1d, and DeepEP merely
# because the complete project source is now present. Install only NeMo-RL
# itself without touching those prebuilt dependencies.
# Install FlashAttention's small runtime companions explicitly. Letting pip
# resolve through its `torch` requirement downloads an older cuDNN plus the
# full CUDA toolkit, all of which would immediately be replaced below.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps -e /opt/nemo-rl \
    && /opt/nemo_rl_venv/bin/python -m pip install \
        --no-deps \
        "flash-attn-4==${FLASH_ATTN_4_VERSION}" \
        "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}" \
        "nvidia-cutlass-dsl-libs-base==${CUTLASS_DSL_VERSION}" \
        "nvidia-cutlass-dsl-libs-cu13==${CUTLASS_DSL_VERSION}" \
        "torch-c-dlpack-ext==0.1.5" \
        "quack-kernels==0.4.1" \
    && /opt/nemo_rl_venv/bin/python -m pip install \
        --no-build-isolation --no-deps --force-reinstall \
        "nvidia-cudnn-cu13==${CUDNN_VERSION}" \
        "nvidia-cudnn-frontend==${CUDNN_FRONTEND_VERSION}" \
        "transformer-engine-cu13==${TRANSFORMER_ENGINE_VERSION}" \
        "transformer-engine==${TRANSFORMER_ENGINE_VERSION}" \
    && NVTE_FRAMEWORK=pytorch /opt/nemo_rl_venv/bin/python -m pip install \
        --no-build-isolation --no-deps --force-reinstall \
        "transformer-engine-torch==${TRANSFORMER_ENGINE_VERSION}"

# The CPU build node intentionally has no NVIDIA driver (`libcuda.so.1`), and
# TE 2.18 loads that driver when imported. Verify exact versions and module
# payloads here; perform the real imports on a GB300 GPU before publishing.
RUN python -c 'exec("""from importlib.metadata import version\nfrom importlib.util import find_spec\nfrom pathlib import Path\nimport os\nexpected = {\n    \"transformer-engine\": os.environ[\"TRANSFORMER_ENGINE_VERSION\"],\n    \"transformer-engine-torch\": os.environ[\"TRANSFORMER_ENGINE_VERSION\"],\n    \"transformer-engine-cu13\": os.environ[\"TRANSFORMER_ENGINE_VERSION\"],\n    \"nvidia-cudnn-cu13\": os.environ[\"CUDNN_VERSION\"],\n    \"nvidia-cudnn-frontend\": os.environ[\"CUDNN_FRONTEND_VERSION\"],\n    \"flash-attn-4\": os.environ[\"FLASH_ATTN_4_VERSION\"],\n    \"nvidia-cutlass-dsl\": os.environ[\"CUTLASS_DSL_VERSION\"],\n}\nfor package, required in expected.items():\n    installed = version(package)\n    assert installed == required, f\"{package}: expected {required}, found {installed}\"\n    print(f\"{package}: {installed}\")\nte = find_spec(\"transformer_engine\")\nfa = find_spec(\"flash_attn\")\nassert te and te.submodule_search_locations\nassert fa and fa.submodule_search_locations\nte_root = Path(next(iter(te.submodule_search_locations)))\nfa_root = Path(next(iter(fa.submodule_search_locations)))\nassert (te_root / \"pytorch\").is_dir()\nassert any(te_root.rglob(\"*.so\"))\nassert (fa_root / \"cute\").is_dir()\nassert find_spec(\"megatron\") and find_spec(\"nemo_rl\")\nprint(\"Validated GB300 package versions and module payloads\")\nprint(\"NeMo-RL:\", version(\"nemo-rl\"))\nprint(\"PyTorch:\", version(\"torch\"))\n""")'

# Install NeMo-Skills without allowing it to rewrite NeMo-RL's locked
# dependency environment. Training commonly mounts a newer Skills checkout at
# /nemo_run/code, while this installation supplies package metadata and tools.
RUN git clone https://github.com/NVIDIA-NeMo/Skills.git /opt/NeMo-Skills \
    && cd /opt/NeMo-Skills \
    && uv pip install --no-deps .

# Generate the fingerprint after every environment mutation.
RUN python tools/generate_fingerprint.py \
    > /opt/nemo_rl_container_fingerprint

RUN echo "This distribution includes open source which is archived at the following URL: https://opensource.nvidia.com/oss/teams/nvidia/nemo-rl/${RC_DATE}:linux-${TARGETARCH}/index.html" \
        > NOTICES.txt \
    && echo "For further inquiries or assistance, contact us at oss-requests@nvidia.com" \
        >> NOTICES.txt

# The image is complete. A runtime `uv run` must use the baked environment and
# must never resolve or download packages independently on every Ray node.
ENV UV_NO_SYNC=1

# Megatron recommends a single CUDA connection when tensor/sequence
# parallelism is enabled so communication can overlap backward GEMMs.
ENV CUDA_DEVICE_MAX_CONNECTIONS=1

WORKDIR /opt/nemo-rl
